# ==============================================================================
# EstimateAI — Environment Configuration Template (.env.example)
# Copy this file to .env and configure your local or deployment secrets.
# NEVER commit real API keys or secrets to version control.
# ==============================================================================

# Server Network Configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# Deterministic Engine Calibration Standards
ENGINE_VERSION=1.0.0
CONFIG_VERSION=1.0.0
RATE_VERSION=1.0.0

# AI Intelligence Layer Configuration
# Options: 'gemini' (live API with fallback) or 'fallback' (offline deterministic NLP)
AI_PROVIDER=fallback
AI_ENABLED=true
AI_MODEL=gemini-1.5-flash
AI_TIMEOUT_SECONDS=30
AI_MAX_TOKENS=2048

# Google Gemini API Key (Required ONLY if AI_PROVIDER=gemini)
# Leave empty for 100% deterministic offline fallback operation
AI_API_KEY=
